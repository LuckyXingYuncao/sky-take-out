sky:
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    host: localhost
    port: 3306
    database: sky_take_out
    username: root
    password: root
  upload:
    path: ./uploads/
    base-url: http://localhost:8080
  wechat:
    appid: ${WECHAT_APPID}
    secret: ${WECHAT_SECRET}

spring:
  redis:
    host: localhost
    port: 6379
    database: 0
  cache:
    type: redis
    redis:
      time-to-live: 3600000
      cache-null-values: false